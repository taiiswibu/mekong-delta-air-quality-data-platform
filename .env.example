# ---------------- Snowflake ----------------
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=AQ_WH
SNOWFLAKE_DATABASE=AQ_WAREHOUSE
SNOWFLAKE_SCHEMA=CONTROL
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---------------- WAQI ----------------
WAQI_TOKEN=replace_me
WAQI_POLL_SECONDS=60

# ---------------- Kafka ----------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:19092
KAFKA_TOPIC_AIR_QUALITY=air_quality.raw
KAFKA_CONSUMER_GROUP=air-quality-snowflake-loader
KAFKA_BATCH_SIZE=50
KAFKA_FLUSH_SECONDS=15

# ---------------- Airflow ----------------
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_JWT_SECRET=local-dev-jwt-secret-change-me-please-32chars
AIRFLOW_API_SECRET_KEY=local-dev-api-secret-change-me-please

# ---------------- Dashboard ----------------
STREAMLIT_SERVER_PORT=8501
